{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/pelayanan",
      "destination": "/index.html"
    },
    {
      "source": "/pelayanan/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/petugas",
      "destination": "/index.html"
    },
    {
      "source": "/petugas/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/meja-petugas",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|favicon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
